#include <iostream>
using namespace std;
#include <string>

int main()
{
    //2-dimensional arrays-Stats of exam result
    
    //create 2D arrays
    int score[3][3] =
    {
        {400, 400, 400},
        {390, 350, 300},
        {360, 370, 380}
        
    };
    
    string names[3] = { "Tony", "Dawson", "Mike" };
    
    //calculate the total score of each student
    for(int i = 0; i < 3; i++)
    {
        int sum = 0;
        for(int j = 0; j < 3; j++)
        {
            sum += score[i][j];
            cout << score[i][j] << " ";
        }
        cout << "The total score of " << names[i] << "is: " << sum << endl;
    }
   
    
    return 0;
}
