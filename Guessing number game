#include <iostream>
using namespace std;
#include <ctime>

int main()
{
    //Prevent the system keep generating the same number
    srand( (unsigned int)time(NULL) );
    
    //Generate a random number
    int num = rand() % 100 + 1; //Generate 0 + 1 ~ 99 + 1
    //cout << num << endl; can get the generating number
    
    int guess = 0; //User's data
    
    while (1)
    {
        //User's guessing
        cout << "Enter your guessing number: " << endl;
        cin >> guess;
        
        //Determine user's guessing
        if (guess > num)
        {
            cout << "Guessing number is bigger than the answer." << endl;
        }
        else if (guess < num)
        {
            cout << "Guessing number is smaller than the answer." << endl;
        }
        else
        {
            cout << "Congrats, you got it!!!" << endl; //Guessing is right, exit the game
            break; //Quit the loop
        }
        
    }
    
    
    return 0;
}
