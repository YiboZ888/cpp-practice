#include <iostream>
using namespace std;
#include <ctime>

int main()
{
    int num[5] = {200, 210, 240, 220, 217};
    
    int max = 0;
    for (int i = 0; i < 5; i++)
    {
        if (num[i] > max)
        {
            max = num[i];
        }
    }
    
    cout << "The max number is: " << max << endl;
    
    return 0;
}
